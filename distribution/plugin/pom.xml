<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ibm</groupId>
        <artifactId>distribution</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <!-- The default plugin (profile plugin). It bundles no SonarSource analyzer: Java and Python
         use the analyzers installed in SonarQube (Plugin-RequirePlugins), and there is no Go. -->
    <artifactId>sonar-cryptography-plugin</artifactId>
    <packaging>sonar-plugin</packaging>
    <description>A SonarQube Plugin to detect cryptographic assets in applications</description>

    <properties>
        <crypto.pluginName>Sonar Crypto Plugin</crypto.pluginName>
    </properties>

    <dependencies>
        <!-- Brings the java, python and csharp modules. sonar-java and sonar-python stay
             'provided' (root pom): their public API packages come from the installed plugins. -->
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>plugin-core</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- No analyzer is bundled, so there are no analyzer legal files to copy
                         (an empty group list would select every group). -->
                    <execution>
                        <id>preserve-analyzer-notices</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.sonar-packaging-maven-plugin</groupId>
                <artifactId>sonar-packaging-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <requirePlugins>java:${sonar.java.minVersion},python:${sonar.python.minVersion}</requirePlugins>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!-- After the shade plugin: copies the JAR to .SonarQube/plugins. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
