<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ibm</groupId>
        <artifactId>sonar-cryptography</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cpp</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- OpenSSL headers auto-fetched for test fixtures (see build/plugins section). -->
        <openssl.skip.configure>false</openssl.skip.configure>
        <openssl.version>3.6.2</openssl.version>
        <openssl.download.url>https://github.com/openssl/openssl/releases/download/openssl-${openssl.version}/openssl-${openssl.version}.tar.gz</openssl.download.url>
        <openssl.headers.dir>${project.build.directory}/test-headers/openssl-${openssl.version}/include</openssl.headers.dir>
    </properties>

    <build>
        <plugins>
            <!--
                Fetch OpenSSL ${openssl.version} source tarball before tests and extract
                `include/` dir into target/test-headers/. The headers are then consumed by
                CxxVerifier (via the `openssl.headers.dir` system property) so sonar-cxx
                can preprocess fixtures that use `#include <openssl/*.h>` realistically.
            -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <executions>
                    <execution>
                        <id>fetch-openssl-headers</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${openssl.download.url}</url>
                            <outputDirectory>${project.build.directory}/test-headers-download</outputDirectory>
                            <outputFileName>openssl-${openssl.version}.tar.gz</outputFileName>
                            <unpack>true</unpack>
                            <skipCache>false</skipCache>
                            <overwrite>false</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Generate real headers from `.h.in` templates and copy the final `include/`
                tree to a stable location. OpenSSL's source tarball ships many headers as
                `.h.in` templates (e.g. ssl.h.in, configuration.h.in); these are rendered
                into `.h` only after running `perl Configure && make build_generated`.

                The `exec-maven-plugin` runs those two steps against the unpacked tarball.
                Then `maven-resources-plugin` copies the fully-generated `include/` tree
                to `${openssl.headers.dir}` which is what CxxVerifier resolves at test time.

                Requires `perl` + `make` on the PATH. Already present on any OpenSSL-capable
                build machine (and on our Ubuntu runner).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>openssl-configure</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>perl</executable>
                            <arguments>
                                <argument>Configure</argument>
                                <argument>no-tests</argument>
                            </arguments>
                            <workingDirectory>${project.build.directory}/test-headers-download/openssl-${openssl.version}</workingDirectory>
                            <skip>${openssl.skip.configure}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>openssl-build-generated</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>make</executable>
                            <arguments>
                                <argument>build_generated</argument>
                            </arguments>
                            <workingDirectory>${project.build.directory}/test-headers-download/openssl-${openssl.version}</workingDirectory>
                            <skip>${openssl.skip.configure}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-openssl-headers</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${openssl.headers.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/test-headers-download/openssl-${openssl.version}/include</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>**/*.in</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Pass headers dir to surefire so CxxVerifier resolves it via System.getProperty. -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <openssl.headers.dir>${openssl.headers.dir}</openssl.headers.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>engine</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>output</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>enricher</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>rules</artifactId>
            <version>2.0.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.sonarsource.analyzer-commons</groupId>
            <artifactId>sonar-analyzer-test-commons</artifactId>
            <version>2.18.0.3393</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
