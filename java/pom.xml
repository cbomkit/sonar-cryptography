<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ibm</groupId>
        <artifactId>sonar-cryptography</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>java</artifactId>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- dcm4che publishes to its own repository; the whole org/dcm4che group is a 404 on
             Maven Central. Declared as a plain URL for the antrun fetch below rather than as a
             <repository>, so Maven's dependency resolution never depends on this host. -->
        <dcm4che.version>5.35.2</dcm4che.version>
        <dcm4che.repository>https://maven.dcm4che.org</dcm4che.repository>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>engine</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>mapper</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>output</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.sonarsource.java</groupId>
            <artifactId>java-checks-testkit</artifactId>
            <version>${sonar.java.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>enricher</artifactId>
            <version>2.0.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.ibm</groupId>
            <artifactId>rules</artifactId>
            <version>2.0.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>


        <dependency>
            <!-- This dependency is not explicitly needed, but having it enables IDE linting in BouncyCastle test files -->
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.1-jre</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- The dcm4che jars the Dcm4che* tests need on the verifier classpath. They are
                     fetched rather than checked in: dcm4che is MPL 1.1 / GPL 2.0 / LGPL 2.1, and
                     carrying the binary in this Apache-2.0 repository would be redistributing it,
                     which brings a source-availability obligation with it. Downloading it here
                     means the developer and CI obtain it from dcm4che directly and this project
                     redistributes nothing. The same pattern already fetches the pinned sonar-go
                     release tree in sonar-cryptography-plugin/pom.xml.

                     ignoreerrors keeps an offline or blocked build green: the download is skipped,
                     Dcm4cheJars.available() returns false, and the two dcm4che test classes report
                     as skipped rather than failing. Their content is pinned by the SHA-256 digests
                     in Dcm4cheJars, so a partial or substituted download counts as absent. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>fetch-dcm4che-test-jars</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/test-jars"/>
                                <get src="${dcm4che.repository}/org/dcm4che/dcm4che-net/${dcm4che.version}/dcm4che-net-${dcm4che.version}.jar"
                                     dest="${project.build.directory}/test-jars/dcm4che-net-${dcm4che.version}.jar"
                                     skipexisting="true" ignoreerrors="true" maxtime="60" retries="3"/>
                                <get src="${dcm4che.repository}/org/dcm4che/dcm4che-core/${dcm4che.version}/dcm4che-core-${dcm4che.version}.jar"
                                     dest="${project.build.directory}/test-jars/dcm4che-core-${dcm4che.version}.jar"
                                     skipexisting="true" ignoreerrors="true" maxtime="60" retries="3"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>